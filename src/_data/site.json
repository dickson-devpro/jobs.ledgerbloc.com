(function () {\n  /* ── Ledger Jobs quiz gate ──────────────────────────────────────────\n     Shows on the FIRST article a visitor lands on in a session, desktop and mobile.\n     Does not reappear as they browse. Returns on a new session.\n     Their two answers actually filter the Indeed links on the page.\n     ------------------------------------------------------------------ */\n\n  /* PASTE YOUR GAM UNITS HERE when the ad account is ready.\n     Leave as null and the gate still runs — it unlocks after the fallback. */\n  var UNITS = {\n    rewarded:     '/23278414648/finance.ledgerbloc.com/rewarded',\n    anchor:       '/23278414648/finance.ledgerbloc.com/anchor',\n    interstitial: '/23278414648/finance.ledgerbloc.com/interstitial'\n  };\n\n  var SEEN_KEY   = 'jq_seen';      // per session, not per 24h\n  var ANS_KEY    = 'jq_answers';\n  var REVEAL_MS  = 700;\n  var PREROLL_MS = 3500;\n  var FALLBACK_MS = 15000;\n  var HINT_MS    = 10000;\n\n  window.googletag = window.googletag || { cmd: [] };\n\n  function ss(k, v) {\n    try {\n      if (v === undefined) return sessionStorage.getItem(k);\n      sessionStorage.setItem(k, v);\n    } catch (e) { return null; }\n  }\n  function seen() { return ss(SEEN_KEY) === '1'; }\n  function markSeen() { ss(SEEN_KEY, '1'); }\n\n  function getAnswers() {\n    try { return JSON.parse(ss(ANS_KEY) || '{}'); } catch (e) { return {}; }\n  }\n  function saveAnswers(a) { ss(ANS_KEY, JSON.stringify(a)); }\n\n  /* Apply the visitor's answers to every Indeed link on the page.\n     jt= is Indeed's job-type filter; fromage= is \"posted within N days\". */\n  function applyAnswers() {\n    var a = getAnswers();\n    if (!a.type && !a.start) return;\n    var jt = a.type === 'fulltime' ? 'fulltime' : a.type === 'parttime' ? 'parttime' : null;\n    var age = a.start === 'now' ? '3' : a.start === 'week' ? '7' : a.start === 'month' ? '30' : null;\n    var links = document.querySelectorAll('a[href*=\"indeed.com/jobs\"]');\n    for (var i = 0; i < links.length; i++) {\n      var href = links[i].getAttribute('href');\n      if (!href) continue;\n      if (jt && href.indexOf('&jt=') === -1) href += '&jt=' + jt;\n      if (age) href = href.replace(/fromage=\\d+/, 'fromage=' + age);\n      links[i].setAttribute('href', href);\n    }\n  }\n\n  /* Pre-paint guard: hide the article before first paint if the gate will show. */\n  (function () {\n    try {\n      if (!seen() &&\n          (document.body.classList.contains('single-post') || document.body.classList.contains('single'))) {\n        document.documentElement.classList.add('jq-pending');\n      }\n    } catch (e) {}\n  })();\n  setTimeout(function () { document.documentElement.classList.remove('jq-pending'); }, 4000);\n\n  var isPost  = document.body.classList.contains('single-post') || document.body.classList.contains('single');\n  var overlay = document.getElementById('jq-overlay');\n\n  function loadOutOfPage(opts) {\n    googletag.cmd.push(function () {\n      if (opts.anchor && UNITS.anchor) {\n        var a = googletag.defineOutOfPageSlot(UNITS.anchor, googletag.enums.OutOfPageFormat.TOP_ANCHOR);\n        if (a) { a.addService(googletag.pubads()); googletag.display(a); }\n      }\n      if (opts.interstitial && UNITS.interstitial && !window._jqInt) {\n        window._jqInt = true;\n        var i = googletag.defineOutOfPageSlot(UNITS.interstitial, googletag.enums.OutOfPageFormat.INTERSTITIAL);\n        if (i) { i.addService(googletag.pubads()); googletag.display(i); }\n      }\n    });\n  }\n\n  /* Already answered this session, or desktop, or not an article: no gate.\n     Their earlier answers still personalise the links. */\n  if (!isPost || seen()) {\n    document.documentElement.classList.remove('jq-pending');\n    if (overlay) overlay.remove();\n    document.body.classList.remove('jq-active');\n    applyAnswers();\n    if (isPost) loadOutOfPage({ anchor: true, interstitial: true });\n    return;\n  }\n\n  if (!overlay) { document.documentElement.classList.remove('jq-pending'); return; }\n\n  document.body.classList.add('jq-active');\n  overlay.style.display = 'flex';\n  document.body.appendChild(overlay);\n  loadOutOfPage({ interstitial: true });\n\n  var answers = {}, adEvt = null, wantsAd = false, armed = false, done = false;\n  var fallbackTimer = null, hintTimer = null;\n\n  if (UNITS.rewarded) {\n    googletag.cmd.push(function () {\n      var r = googletag.defineOutOfPageSlot(UNITS.rewarded, googletag.enums.OutOfPageFormat.REWARDED);\n      if (!r) return;\n      r.addService(googletag.pubads());\n      googletag.pubads().addEventListener('rewardedSlotReady', function (e) {\n        adEvt = e;\n        if (wantsAd && armed && !done) { try { adEvt.makeRewardedVisible(); } catch (err) { finish(); } }\n      });\n      googletag.pubads().addEventListener('rewardedSlotGranted', finish);\n      googletag.pubads().addEventListener('rewardedSlotClosed', finish);\n      googletag.display(r);\n    });\n  }\n\n  setTimeout(function () {\n    if (done) return;\n    document.documentElement.classList.remove('jq-pending');\n    document.body.classList.add('jq-visible');\n    overlay.classList.add('jq-shown');\n  }, REVEAL_MS);\n\n  function showStep(n) {\n    var steps = overlay.querySelectorAll('.jq-step');\n    for (var i = 0; i < steps.length; i++) steps[i].classList.remove('on');\n    var t = document.getElementById('jq-step-' + n);\n    if (t) t.classList.add('on');\n    var bar = document.getElementById('jq-bar');\n    if (bar) bar.style.width = (n === 1 ? 33 : n === 2 ? 66 : 100) + '%';\n  }\n\n  /* Say plainly what the answers will do — so the promise is true. */\n  function summarise() {\n    var bits = [];\n    if (answers.type === 'fulltime') bits.push('full-time roles');\n    else if (answers.type === 'parttime') bits.push('part-time roles');\n    else bits.push('all roles');\n    if (answers.start === 'now') bits.push('posted in the last 3 days');\n    else if (answers.start === 'week') bits.push('posted this week');\n    else if (answers.start === 'month') bits.push('posted this month');\n    var el = document.getElementById('jq-summary');\n    if (el) el.textContent = 'Your search will show ' + bits.join(', ') + '.';\n  }\n\n  overlay.querySelectorAll('.jq-opt').forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      var q = btn.getAttribute('data-q'), v = btn.getAttribute('data-v');\n      answers[q] = v;\n      saveAnswers(answers);\n      if (typeof window.gtag === 'function') window.gtag('event', 'jq_' + q, { value: v });\n      if (q === 'type') showStep(2);\n      else { summarise(); showStep(3); }\n    });\n  });\n\n  overlay.querySelectorAll('[data-action=\"back\"]').forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      if (document.referrer && document.referrer !== window.location.href) window.location.href = document.referrer;\n      else window.history.back();\n    });\n  });\n\n  var trigger = overlay.querySelector('[data-trigger=\"reward\"]');\n  if (trigger) {\n    trigger.addEventListener('click', function () {\n      if (done) return;\n      wantsAd = true;\n      overlay.querySelectorAll('.jq-step').forEach(function (s) { s.classList.remove('on'); });\n      var l = document.getElementById('jq-loading');\n      if (l) l.classList.add('on');\n      hintTimer = setTimeout(function () {\n        var h = document.getElementById('jq-hint'); if (h) h.classList.add('on');\n      }, HINT_MS);\n      fallbackTimer = setTimeout(finish, FALLBACK_MS);\n      setTimeout(function () {\n        armed = true;\n        if (adEvt && !done) { try { adEvt.makeRewardedVisible(); } catch (e) { finish(); } }\n      }, PREROLL_MS);\n    });\n  }\n\n  function finish() {\n    if (done) return;\n    done = true;\n    if (fallbackTimer) clearTimeout(fallbackTimer);\n    if (hintTimer) clearTimeout(hintTimer);\n    markSeen();\n    if (overlay) overlay.remove();\n    document.documentElement.classList.remove('jq-pending');\n    document.body.classList.remove('jq-active', 'jq-visible');\n    document.body.classList.add('jq-unlocked');\n    document.body.style.overflow = '';\n    applyAnswers();\n    loadOutOfPage({ anchor: true });\n  }\n})();\n\n</script>"
