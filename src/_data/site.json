.time) < LOCK_MS;\n    } catch (e) { return false; }\n  }\n  function setUnlocked() {\n    try { localStorage.setItem(LOCK_KEY, JSON.stringify({ time: Date.now() })); } catch (e) {}\n  }\n\n  setTimeout(function () { document.documentElement.classList.remove('gate-pending'); }, 4000);\n\n  var isPost   = document.body.classList.contains('single-post') ||\n                 document.body.classList.contains('single');\n  var isMobile = window.innerWidth <= 768;\n  var overlay  = document.getElementById('reward-gate-overlay');\n\n  function loadOutOfPage(opts) {\n    googletag.cmd.push(function () {\n      if (opts.anchor) {\n        var a = googletag.defineOutOfPageSlot(UNITS.anchor, googletag.enums.OutOfPageFormat.TOP_ANCHOR);\n        if (a) { a.addService(googletag.pubads()); googletag.display(a); }\n      }\n      if (opts.interstitial && !window._pnInterstitial) {\n        window._pnInterstitial = true;\n        var i = googletag.defineOutOfPageSlot(UNITS.interstitial, googletag.enums.OutOfPageFormat.INTERSTITIAL);\n        if (i) { i.addService(googletag.pubads()); googletag.display(i); }\n      }\n    });\n  }\n\n  /* Not an article: no gate, no out-of-page formats. */\n  if (!isPost) { document.documentElement.classList.remove('gate-pending'); if (overlay) overlay.remove(); return; }\n\n  /* Desktop, or already unlocked: never gate — anchor + interstitial straight away. */\n  if (!isMobile || isUnlocked()) {\n    document.documentElement.classList.remove('gate-pending');\n    if (overlay) overlay.remove();\n    document.body.classList.remove('gate-active');\n    if (isUnlocked()) document.body.classList.add('content-unlocked');\n    loadOutOfPage({ anchor: true, interstitial: true });\n    return;\n  }\n\n  /* ── First mobile article view in 24h ── */\n  if (!overlay) { loadOutOfPage({ anchor: true, interstitial: true }); return; }\n\n  document.body.classList.add('gate-active');\n  overlay.style.display = 'flex';\n  document.body.appendChild(overlay);\n\n  /* Interstitial can run alongside the gate; anchor waits until after unlock. */\n  loadOutOfPage({ interstitial: true });\n\n  var adEvt = null, wantsAd = false, armed = false, done = false;\n  var fallbackTimer = null, hintTimer = null;\n\n  googletag.cmd.push(function () {\n    var r = googletag.defineOutOfPageSlot(UNITS.rewarded, googletag.enums.OutOfPageFormat.REWARDED);\n    if (!r) return;   /* unsupported: the fallback timer still frees the reader */\n    r.addService(googletag.pubads());\n    googletag.pubads().addEventListener('rewardedSlotReady', function (e) {\n      adEvt = e;\n      if (wantsAd && armed && !done) { try { adEvt.makeRewardedVisible(); } catch (err) { finish(); } }\n    });\n    googletag.pubads().addEventListener('rewardedSlotGranted', finish);\n    googletag.pubads().addEventListener('rewardedSlotClosed', finish);\n    googletag.display(r);\n  });\n\n  /* Reveal the gate after a beat so the page paints first. */\n  setTimeout(function () {\n    if (done || isUnlocked()) return;\n    document.documentElement.classList.remove('gate-pending');\n    document.body.classList.add('gate-visible');\n    overlay.classList.add('gate-shown');\n  }, REVEAL_MS);\n\n  /* Step navigation + interest capture */\n  overlay.querySelectorAll('[data-next]').forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      overlay.querySelectorAll('.gate-step').forEach(function (s) { s.classList.remove('active'); });\n      var id = btn.getAttribute('data-next');\n      var target = id === 'unlock'\n        ? document.getElementById('gate-step-unlock')\n        : document.getElementById('gate-step-' + id);\n      if (target) target.classList.add('active');\n    });\n  });\n\n  /* Back out */\n  overlay.querySelectorAll('[data-action=\"back\"]').forEach(function (btn) {\n    btn.addEventListener('click', function () {\n      if (document.referrer && document.referrer !== window.location.href) {\n        window.location.href = document.referrer;\n   