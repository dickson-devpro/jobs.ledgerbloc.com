ont-size: 0.82rem !important;\n    font-weight: 500 !important;\n    color: #92400e !important;\n    text-align: center !important;\n    line-height: 1.5 !important;\n  }\n\n  #gate-stuck-hint.visible {\n    display: block !important;\n  }\n\n  .gate-spinner {\n    width: 50px !important;\n    height: 50px !important;\n    border: 4px solid #eef2ff !important;\n    border-top-color: #4f46e5 !important;\n    border-radius: 50% !important;\n    animation: gate-spin 0.8s linear infinite !important;\n    margin: 0 auto !important;\n  }\n\n  @keyframes gate-spin {\n    to { transform: rotate(360deg); }\n  }\n\n  @media (max-width: 480px) {\n    #reward-gate-modal {\n      padding: 26px 22px 22px !important;\n    }\n\n    #reward-gate-modal .gate-heading {\n      font-size: 1.35rem !important;\n    }\n\n    #reward-gate-modal .gate-subtext {\n      font-size: 0.9rem !important;\n    }\n\n    #reward-gate-modal .gate-btn-primary {\n      font-size: 0.95rem !important;\n      padding: 16px 18px !important;\n    }\n  }\n</style>\n\n<div id=\"reward-gate-overlay\" style=\"display:none;\">\n  <div id=\"reward-gate-modal\">\n\n    <!-- STEP 1 of 2 -->\n    <div class=\"gate-step active\" id=\"gate-step-1\">\n\n      <div class=\"gate-progress\">\n        <div class=\"gate-progress-segment active\"></div>\n        <div class=\"gate-progress-segment\"></div>\n      </div>\n\n      <span class=\"gate-step-label\">Step 1 of 2</span>\n\n      <div class=\"gate-icon-circle\">📄</div>\n\n      <h2 class=\"gate-heading\">Want to Read This Article?</h2>\n\n      <p class=\"gate-subtext\">\n        This article is available for free. Tap below to continue and see how to access it.\n      </p>\n\n      <button class=\"gate-btn-primary\" data-next=\"unlock\">\n        Yes, I want to read it\n      </button>\n\n    </div>\n\n    <!-- STEP 2 of 2 -->\n    <div class=\"gate-step\" id=\"gate-step-unlock\">\n\n      <div class=\"gate-progress\">\n        <div class=\"gate-progress-segment active\"></div>\n        <div class=\"gate-progress-segment active\"></div>\n      </div>\n\n      <span class=\"gate-step-label\">Step 2 of 2</span>\n\n      <div class=\"gate-icon-circle\">✅</div>\n\n      <h2 class=\"gate-heading\">You're All Set!</h2>\n\n      <p class=\"gate-subtext\">\n        Watch a short ad to unlock the full guide.\n      </p>\n\n      <button class=\"gate-btn-primary\" data-trigger=\"reward\">\n        ▶ WATCH AD TO CONTINUE\n      </button>\n\n      <p id=\"gate-ad-note\">\n        ⏱ Takes only a few seconds. No sign-up needed.\n      </p>\n\n      <p id=\"gate-disclaimer\">\n        A short ad may play before access unlocks. Ads are served by Google.\n      </p>\n\n    </div>\n\n    <!-- LOADING SCREEN -->\n    <div id=\"gate-loading\">\n\n      <div class=\"gate-spinner\"></div>\n\n      <p id=\"gate-loading-text\">\n        Preparing your guide…\n      </p>\n\n      <div id=\"gate-stuck-hint\">\n        Ad finished but stuck? Tap the small 'X' or 'Close' at the top of your screen to access the guide.\n      </div>\n\n    </div>\n\n  </div>\n</div>\n\n<script>\n(function () {\n\n  /* ── Ledgerbloc gate + out-of-page engine ── */\n\n  var UNITS = {\n    anchor:       '/23278414648/finance.ledgerbloc.com/anchor',\n    interstitial: '/23278414648/finance.ledgerbloc.com/interstitial',\n    rewarded:     '/23278414648/finance.ledgerbloc.com/rewarded'\n  };\n\n  var LOCK_KEY    = 'content_unlocked';\n  var LOCK_MS     = 24 * 60 * 60 * 1000;\n  var REVEAL_MS   = 700;\n  var PREROLL_MS  = 3500;\n  var FALLBACK_MS = 15000;\n  var HINT_MS     = 10000;\n\n  window.googletag = window.googletag || { cmd: [] };\n\n  /* ── Pre-paint guard ── */\n\n  (function () {\n    try {\n\n      var m = window.innerWidth <= 768;\n      var b = document.body;\n\n      var post = b && (\n        b.classList.contains('single-post') ||\n        b.classList.contains('single')\n      );\n\n      var d = JSON.parse(\n        localStorage.getItem('content_unlocked')\n      );\n\n      var unlocked =\n        !!d &&\n        (Date.now() - d.time) < 24 * 60 * 60 * 1000;\n\n      if (m && post && !unlocked) {\n        document.documentElement.classList.add(\n          'gate-pending'\n        );\n      }\n\n    } catch (e) {}\n  })();\n\n  function isUnlocked() {\n\n    try {\n\n      var d = JSON.parse(\n        localStorage.getItem(LOCK_KEY)\n      );\n\n      return !!d &&\n        (Date.now() - d.time) < LOCK_MS;\n\n    } catch (e) {\n\n      return false;\n\n    }\n  }\n\n  function setUnlocked() {\n\n    try {\n\n      localStorage.setItem(\n        LOCK_KEY,\n        JSON.stringify({\n          time: Date.now()\n        })\n      );\n\n    } catch (e) {}\n\n  }\n\n  setTimeout(function () {\n\n    document.documentElement.classList.remove(\n      'gate-pending'\n    );\n\n  }, 4000);\n\n  var isPost =\n    document.body.classList.contains('single-post') ||\n    document.body.classList.contains('single');\n\n  var isMobile = window.innerWidth <= 768;\n\n  var overlay =\n    document.getElementById(\n      'reward-gate-overlay'\n    );\n\n  function loadOutOfPage(opts) {\n\n    googletag.cmd.push(function () {\n\n      if (opts.anchor) {\n\n        var a =\n          googletag.defineOutOfPageSlot(\n            UNITS.anchor,\n            googletag.enums.OutOfPageFormat.TOP_ANCHOR\n          );\n\n        if (a) {\n\n          a.addService(\n            googletag.pubads()\n          );\n\n          googletag.display(a);\n\n        }\n      }\n\n      if (\n        opts.interstitial &&\n        !window._pnInterstitial\n      ) {\n\n        window._pnInterstitial = true;\n\n        var i =\n          googletag.defineOutOfPageSlot(\n            UNITS.interstitial,\n            googletag.enums.OutOfPageFormat.INTERSTITIAL\n          );\n\n        if (i) {\n\n          i.addService(\n            googletag.pubads()\n          );\n\n          googletag.display(i);\n\n        }\n      }\n\n    });\n  }\n\n  /* ── Not an article ── */\n\n  if (!isPost) {\n\n    document.documentElement.classList.remove(\n      'gate-pending'\n    );\n\n    if (overlay) {\n      overlay.remove();\n    }\n\n    return;\n  }\n\n  /* ── Desktop or already unlocked ── */\n\n  if (!isMobile || isUnlocked()) {\n\n    document.documentElement.classList.remove(\n      'gate-pending'\n    );\n\n    if (overlay) {\n      overlay.remove();\n    }\n\n    document.body.classList.remove(\n      'gate-active'\n    );\n\n    if (isUnlocked()) {\n\n      document.body.classList.add(\n        'content-unlocked'\n      );\n\n    }\n\n    loadOutOfPage({\n      anchor: true,\n      interstitial: true\n    });\n\n    return;\n  }\n\n  /* ── First mobile article view in 24h ── */\n\n  if (!overlay) {\n\n    loadOutOfPage({\n      anchor: true,\n      interstitial: true\n    });\n\n    return;\n  }\n\n  document.body.classList.add(\n    'gate-active'\n  );\n\n  overlay.style.display = 'flex';\n\n  document.body.appendChild(\n    overlay\n  );\n\n  /* Interstitial can run alongside the gate */\n  loadOutOfPage({\n    interstitial: true\n  });\n\n  var adEvt = null;\n  var wantsAd = false;\n  var armed = false;\n  var done = false;\n\n  var fallbackTimer = null;\n  var hintTimer = null;\n\n  /* ── Rewarded ad setup ── */\n\n  googletag.cmd.push(function () {\n\n    var r =\n      googletag.defineOutOfPageSlot(\n        UNITS.rewarded,\n        googletag.enums.OutOfPageFormat.REWARDED\n      );\n\n    if (!r) return;\n\n    r.addService(\n      googletag.pubads()\n    );\n\n    googletag.pubads().addEventListener(\n      'rewardedSlotReady',\n      function (e) {\n\n        adEvt = e;\n\n        if (\n          wantsAd &&\n          armed &&\n          !done\n        ) {\n\n          try {\n\n            adEvt.makeRewardedVisible();\n\n          } catch (err) {\n\n            finish();\n\n          }\n        }\n\n      }\n    );\n\n    googletag.pubads().addEventListener(\n      'rewardedSlotGranted',\n      finish\n    );\n\n    googletag.pubads().addEventListener(\n      'rewardedSlotClosed',\n      finish\n    );\n\n    googletag.display(r);\n\n  });\n\n  /* ── Reveal gate ── */\n\n  setTimeout(function () {\n\n    if (\n      done ||\n      isUnlocked()\n    ) return;\n\n    document.documentElement.classList.remove(\n      'gate-pending'\n    );\n\n    document.body.classList.add(\n      'gate-visible'\n    );\n\n    overlay.classList.add(\n      'gate-shown'\n    );\n\n  }, REVEAL_MS);\n\n  /* ── Step navigation ── */\n\n  overlay\n    .querySelectorAll('[data-next]')\n    .forEach(function (btn) {\n\n      btn.addEventListener(\n        'click',\n        function () {\n\n          overlay\n            .querySelectorAll('.gate-step')\n            .forEach(function (s) {\n\n              s.classList.remove(\n                'active'\n              );\n\n            });\n\n          var id =\n            btn.getAttribute(\n              'data-next'\n            );\n\n          var target =\n            id === 'unlock'\n              ? document.getElementById(\n                  'gate-step-unlock'\n                )\n              : document.getElementById(\n                  'gate-step-' + id\n                );\n\n          if (target) {\n\n            target.classList.add(\n              'active'\n            );\n\n          }\n\n        }\n      );\n\n    });\n\n  /* ── Watch ad ── */\n\n  var trigger =\n    overlay.querySelector(\n      '[data-trigger=\"reward\"]'\n    );\n\n  if (trigger) {\n\n    trigger.addEventListener(\n      'click',\n      function () {\n\n        if (done) return;\n\n        wantsAd = true;\n\n        overlay\n          .querySelectorAll('.gate-step')\n          .forEach(function (s) {\n\n            s.classList.remove(\n              'active'\n            );\n\n          });\n\n        var loading =\n          document.getElementById(\n            'gate-loading'\n          );\n\n        if (loading) {\n\n          loading.classList.add(\n            'active'\n          );\n\n        }\n\n        hintTimer =\n          setTimeout(\n            function () {\n\n              var hint =\n                document.getElementById(\n                  'gate-stuck-hint'\n                );\n\n              if (hint) {\n\n                hint.classList.add(\n                  'visible'\n                );\n\n              }\n\n            },\n            HINT_MS\n          );\n\n        fallbackTimer =\n          setTimeout(\n            finish,\n            FALLBACK_MS\n          );\n\n        setTimeout(\n          function () {\n\n            armed = true;\n\n            if (\n              adEvt &&\n              !done\n            ) {\n\n              try {\n\n                adEvt.makeRewardedVisible();\n\n              } catch (e) {\n\n                finish();\n\n              }\n\n            }\n\n          },\n          PREROLL_MS\n        );\n\n      }\n    );\n\n  }\n\n  /* ── Unlock ── */\n\n  function finish() {\n\n    if (done) return;\n\n    done = true;\n\n    if (fallbackTimer) {\n\n      clearTimeout(\n        fallbackTimer\n      );\n\n    }\n\n    if (hintTimer) {\n\n      clearTimeout(\n        hintTimer\n      );\n\n    }\n\n    setUnlocked();\n\n    if (overlay) {\n\n      overlay.remove();\n\n    }\n\n    document.documentElement.classList.remove(\n      'gate-pending'\n    );\n\n    document.body.classList.remove(\n      'gate-active',\n      'gate-visible'\n    );\n\n    document.body.classList.add(\n      'content-unlocked'\n    );\n\n    document.body.style.overflow = '';\n\n    loadOutOfPage({\n      anchor: true\n    });\n\n  }\n\n})();\n</script>"
